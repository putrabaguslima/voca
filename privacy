  <link rel="icon" type="image/png" href="assets/AppLogo.png">
  <style>
/*
 * Voca - AI Expense Tracker
 * App Store Web Pages (Marketing, Privacy, Support, Terms)
 * Design Language: iOS 18 / Apple Human Interface Guidelines inspired
 */

:root {
  --font-sans: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", system-ui, sans-serif;
  --font-mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;

  /* Light Theme (Default) */
  --bg-primary: #ffffff;
  --bg-secondary: #fbfbfd;
  --bg-tertiary: #f5f5f7;
  --bg-card: #ffffff;
  --bg-card-hover: #fafafa;
  --border-subtle: rgba(0, 0, 0, 0.08);
  --border-focus: rgba(0, 113, 227, 0.6);
  --text-primary: #1d1d1f;
  --text-secondary: #6e6e73;
  --text-tertiary: #86868b;
  --accent-color: #0071e3;
  --accent-hover: #0077ed;
  --accent-soft: rgba(0, 113, 227, 0.08);
  --success-color: #34c759;
  --nav-bg: rgba(255, 255, 255, 0.82);
  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.04);
  --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.06);

  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --radius-full: 9999px;

  --container-max: 1040px;
  --transition-fast: 0.15s ease;
  --transition-normal: 0.25s ease;
}

[data-theme="dark"] {
  --bg-primary: #000000;
  --bg-secondary: #0c0c0e;
  --bg-tertiary: #161618;
  --bg-card: #121214;
  --bg-card-hover: #19191d;
  --border-subtle: rgba(255, 255, 255, 0.12);
  --border-focus: rgba(41, 151, 255, 0.7);
  --text-primary: #f5f5f7;
  --text-secondary: #a1a1a6;
  --text-tertiary: #86868b;
  --accent-color: #2997ff;
  --accent-hover: #47a6ff;
  --accent-soft: rgba(41, 151, 255, 0.14);
  --success-color: #30d158;
  --nav-bg: rgba(18, 18, 20, 0.84);
  --shadow-sm: 0 2px 10px rgba(0, 0, 0, 0.35);
  --shadow-md: 0 8px 28px rgba(0, 0, 0, 0.5);
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg-primary: #000000;
    --bg-secondary: #0c0c0e;
    --bg-tertiary: #161618;
    --bg-card: #121214;
    --bg-card-hover: #19191d;
    --border-subtle: rgba(255, 255, 255, 0.12);
    --border-focus: rgba(41, 151, 255, 0.7);
    --text-primary: #f5f5f7;
    --text-secondary: #a1a1a6;
    --text-tertiary: #86868b;
    --accent-color: #2997ff;
    --accent-hover: #47a6ff;
    --accent-soft: rgba(41, 151, 255, 0.14);
    --success-color: #30d158;
    --nav-bg: rgba(18, 18, 20, 0.84);
    --shadow-sm: 0 2px 10px rgba(0, 0, 0, 0.35);
    --shadow-md: 0 8px 28px rgba(0, 0, 0, 0.5);
  }
}

/* Reset & Base */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-family: var(--font-sans);
  background-color: var(--bg-primary);
  color: var(--text-primary);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-size: 16px;
}

/* Typography Hierarchy */
h1, h2, h3, h4, h5, h6 {
  color: var(--text-primary);
  font-weight: 600;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

h1 {
  font-size: 2.75rem;
  letter-spacing: -0.03em;
}

h2 {
  font-size: 2rem;
  letter-spacing: -0.025em;
}

h3 {
  font-size: 1.35rem;
}

p {
  color: var(--text-secondary);
  line-height: 1.6;
}

a {
  color: var(--accent-color);
  text-decoration: none;
  cursor: pointer;
  transition: color var(--transition-fast);
}

a:hover {
  text-decoration: underline;
}

/* Accessibility Focus Outline */
:focus-visible {
  outline: 2px solid var(--border-focus);
  outline-offset: 3px;
}

button {
  font-family: inherit;
  cursor: pointer;
  border: none;
  background: none;
}

/* Layout Utilities */
.container {
  width: 100%;
  max-width: var(--container-max);
  margin-left: auto;
  margin-right: auto;
  padding-left: 20px;
  padding-right: 20px;
}

.text-container {
  max-width: 760px;
  margin-left: auto;
  margin-right: auto;
}

/* Site Header & Navigation */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: var(--nav-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border-subtle);
  height: 64px;
  display: flex;
  align-items: center;
}

.nav-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.brand-link {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--text-primary);
  text-decoration: none;
  font-weight: 600;
  font-size: 1.15rem;
  letter-spacing: -0.01em;
}

.brand-link:hover {
  text-decoration: none;
}

.brand-logo {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  border: 1px solid var(--border-subtle);
  object-fit: cover;
  display: block;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 24px;
  list-style: none;
}

.nav-link {
  color: var(--text-secondary);
  font-size: 0.92rem;
  font-weight: 500;
  text-decoration: none;
  transition: color var(--transition-fast);
}

.nav-link:hover,
.nav-link.active {
  color: var(--text-primary);
  text-decoration: none;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

/* Theme Toggle Button */
.theme-toggle {
  width: 36px;
  height: 36px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  color: var(--text-secondary);
  border: 1px solid var(--border-subtle);
  background-color: var(--bg-card);
  transition: all var(--transition-fast);
}

.theme-toggle:hover {
  color: var(--text-primary);
  background-color: var(--bg-tertiary);
}

.theme-toggle svg {
  width: 18px;
  height: 18px;
  fill: currentColor;
}

/* Primary App Store CTA */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background-color: var(--text-primary);
  color: var(--bg-primary);
  padding: 10px 18px;
  border-radius: var(--radius-sm);
  font-size: 0.92rem;
  font-weight: 600;
  text-decoration: none;
  transition: opacity var(--transition-fast);
  min-height: 44px;
}

.btn-primary:hover {
  opacity: 0.92;
  text-decoration: none;
  color: var(--bg-primary);
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background-color: var(--bg-tertiary);
  color: var(--text-primary);
  padding: 10px 18px;
  border-radius: var(--radius-sm);
  font-size: 0.92rem;
  font-weight: 500;
  border: 1px solid var(--border-subtle);
  text-decoration: none;
  transition: background-color var(--transition-fast);
  min-height: 44px;
}

.btn-secondary:hover {
  background-color: var(--bg-card-hover);
  text-decoration: none;
}

/* Hero Section (Marketing) */
.hero-section {
  padding-top: 72px;
  padding-bottom: 64px;
  text-align: center;
}

.hero-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 12px;
  border-radius: var(--radius-full);
  background-color: var(--bg-tertiary);
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
  font-size: 0.8rem;
  font-weight: 600;
  margin-bottom: 24px;
}

.hero-pill strong {
  color: var(--accent-color);
}

.hero-title {
  font-size: clamp(2.4rem, 5vw, 3.6rem);
  max-width: 820px;
  margin-left: auto;
  margin-right: auto;
  margin-bottom: 20px;
}

.hero-subtitle {
  font-size: clamp(1.1rem, 2vw, 1.25rem);
  max-width: 640px;
  margin-left: auto;
  margin-right: auto;
  margin-bottom: 32px;
  color: var(--text-secondary);
}

.hero-actions {
  display: flex;
  justify-content: center;
  gap: 14px;
  flex-wrap: wrap;
}

/* App Mockup / Visual Stage */
.device-stage {
  margin-top: 48px;
  position: relative;
  max-width: 860px;
  margin-left: auto;
  margin-right: auto;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-subtle);
  background: linear-gradient(180deg, var(--bg-secondary) 0%, var(--bg-card) 100%);
  padding: 36px 28px;
  box-shadow: var(--shadow-md);
}

.mockup-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  text-align: left;
}

.mockup-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 20px;
  box-shadow: var(--shadow-sm);
}

.mockup-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}

.mockup-card-title {
  font-size: 0.85rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--text-tertiary);
}

.mockup-value {
  font-size: 1.8rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
  margin-bottom: 6px;
}

.mockup-subvalue {
  font-size: 0.82rem;
  color: var(--text-secondary);
}

.receipt-item-row {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
  border-bottom: 1px solid var(--border-subtle);
  font-size: 0.9rem;
}

.receipt-item-row:last-child {
  border-bottom: none;
}

.siri-pill-card {
  display: flex;
  align-items: center;
  gap: 12px;
  background-color: var(--bg-tertiary);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 14px 18px;
  grid-column: 1 / -1;
}

.siri-icon {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  flex-shrink: 0;
}

/* Feature Grid Section */
.features-section {
  padding: 80px 0;
  border-top: 1px solid var(--border-subtle);
}

.section-header {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 52px;
}

.section-eyebrow {
  font-size: 0.82rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--accent-color);
  margin-bottom: 8px;
}

.section-title {
  margin-bottom: 12px;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 24px;
}

.feature-box {
  background-color: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 28px;
  transition: border-color var(--transition-fast), transform var(--transition-fast);
}

.feature-box:hover {
  border-color: var(--border-focus);
}

.feature-icon-wrapper {
  width: 44px;
  height: 44px;
  border-radius: var(--radius-sm);
  background-color: var(--accent-soft);
  color: var(--accent-color);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
}

.feature-icon-wrapper svg {
  width: 22px;
  height: 22px;
  stroke: currentColor;
  stroke-width: 2;
  fill: none;
}

.feature-box h3 {
  margin-bottom: 8px;
  font-size: 1.2rem;
}

.feature-box p {
  font-size: 0.95rem;
}

/* Pricing Section */
.pricing-section {
  padding: 80px 0;
  border-top: 1px solid var(--border-subtle);
  background-color: var(--bg-secondary);
}

.pricing-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
  max-width: 960px;
  margin: 0 auto;
}

.pricing-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 28px;
  display: flex;
  flex-direction: column;
  position: relative;
}

.pricing-card.featured {
  border-color: var(--text-primary);
  border-width: 1.5px;
}

.pricing-tag {
  position: absolute;
  top: 16px;
  right: 16px;
  font-size: 0.75rem;
  font-weight: 600;
  padding: 3px 8px;
  border-radius: var(--radius-sm);
  background-color: var(--accent-soft);
  color: var(--accent-color);
}

.pricing-name {
  font-size: 1.2rem;
  font-weight: 600;
  margin-bottom: 6px;
}

.pricing-desc {
  font-size: 0.88rem;
  margin-bottom: 20px;
}

.pricing-cost {
  margin-bottom: 24px;
}

.pricing-amount {
  font-size: 2.5rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.pricing-period {
  font-size: 0.92rem;
  color: var(--text-secondary);
}

.pricing-features-list {
  list-style: none;
  margin-bottom: 28px;
  flex-grow: 1;
}

.pricing-feature-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 0.9rem;
  color: var(--text-secondary);
  margin-bottom: 12px;
}

.pricing-feature-item svg {
  width: 16px;
  height: 16px;
  stroke: var(--success-color);
  stroke-width: 2.5;
  fill: none;
  flex-shrink: 0;
  margin-top: 3px;
}

/* Legal Documents & Content Pages (Privacy, Terms, Support) */
.page-header {
  padding-top: 56px;
  padding-bottom: 40px;
  border-bottom: 1px solid var(--border-subtle);
  background-color: var(--bg-secondary);
}

.page-title {
  font-size: 2.4rem;
  margin-bottom: 10px;
}

.page-meta {
  color: var(--text-tertiary);
  font-size: 0.9rem;
}

.legal-content {
  padding: 56px 0 80px;
}

.legal-section {
  margin-bottom: 40px;
}

.legal-section h2 {
  font-size: 1.45rem;
  margin-bottom: 14px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--border-subtle);
}

.legal-section h3 {
  font-size: 1.15rem;
  margin-top: 20px;
  margin-bottom: 10px;
}

.legal-section p {
  margin-bottom: 14px;
  font-size: 1rem;
}

.legal-section ul,
.legal-section ol {
  margin-left: 24px;
  margin-bottom: 16px;
  color: var(--text-secondary);
}

.legal-section li {
  margin-bottom: 8px;
  line-height: 1.6;
}

.callout-box {
  background-color: var(--bg-tertiary);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  padding: 16px 20px;
  margin: 20px 0;
}

.callout-box strong {
  color: var(--text-primary);
  display: block;
  margin-bottom: 4px;
}

/* Support Accordion & Form */
.support-grid {
  display: grid;
  grid-template-columns: 1fr 340px;
  gap: 40px;
  align-items: start;
}

.faq-group {
  margin-bottom: 32px;
}

.faq-item {
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  background-color: var(--bg-card);
  margin-bottom: 12px;
  overflow: hidden;
}

.faq-question {
  width: 100%;
  text-align: left;
  padding: 16px 20px;
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--text-primary);
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: background-color var(--transition-fast);
}

.faq-question:hover {
  background-color: var(--bg-tertiary);
}

.faq-arrow {
  width: 16px;
  height: 16px;
  transition: transform var(--transition-fast);
  stroke: var(--text-tertiary);
  stroke-width: 2;
  fill: none;
}

.faq-item.open .faq-arrow {
  transform: rotate(180deg);
}

.faq-answer {
  display: none;
  padding: 0 20px 18px;
  color: var(--text-secondary);
  font-size: 0.95rem;
  line-height: 1.6;
}

.faq-item.open .faq-answer {
  display: block;
}

.support-sidebar-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 24px;
  box-shadow: var(--shadow-sm);
  position: sticky;
  top: 88px;
}

.support-sidebar-card h3 {
  margin-bottom: 10px;
}

.support-contact-list {
  list-style: none;
  margin-top: 16px;
}

.support-contact-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 14px;
  font-size: 0.92rem;
}

/* Site Footer */
.site-footer {
  margin-top: auto;
  border-top: 1px solid var(--border-subtle);
  background-color: var(--bg-secondary);
  padding: 48px 0 32px;
  font-size: 0.88rem;
}

.footer-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 32px;
  margin-bottom: 40px;
}

.footer-brand {
  max-width: 320px;
}

.footer-brand-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 600;
  font-size: 1.1rem;
  color: var(--text-primary);
  margin-bottom: 10px;
}

.footer-brand-logo img {
  width: 28px;
  height: 28px;
  border-radius: 6px;
}

.footer-links-group {
  display: flex;
  gap: 48px;
  flex-wrap: wrap;
}

.footer-col h4 {
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--text-tertiary);
  margin-bottom: 14px;
}

.footer-col ul {
  list-style: none;
}

.footer-col li {
  margin-bottom: 8px;
}

.footer-col a {
  color: var(--text-secondary);
}

.footer-col a:hover {
  color: var(--text-primary);
}

.footer-bottom {
  border-top: 1px solid var(--border-subtle);
  padding-top: 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
  color: var(--text-tertiary);
  font-size: 0.82rem;
}

/* Responsive Breakpoints */
@media (max-width: 768px) {
  .site-header {
    height: auto;
    padding: 12px 0;
  }

  .nav-wrapper {
    flex-wrap: wrap;
    gap: 12px;
  }

  .nav-links {
    order: 3;
    width: 100%;
    justify-content: space-between;
    padding-top: 8px;
    border-top: 1px solid var(--border-subtle);
    gap: 12px;
    font-size: 0.86rem;
  }

  .mockup-grid {
    grid-template-columns: 1fr;
  }

  .support-grid {
    grid-template-columns: 1fr;
  }

  .support-sidebar-card {
    position: static;
  }

  .footer-top {
    flex-direction: column;
    gap: 24px;
  }
}

  </style>
</head>
